# ============================================================================
# Praxis — PRODUCTION environment (docker-compose.prod.yml)
# ----------------------------------------------------------------------------
# Copy to `.env.prod` and adjust:  cp .env.prod.example .env.prod
# Compose reads it via `--env-file .env.prod` (see the `just prod-*` recipes).
# NEVER commit real secrets. Every value below has a safe local default.
# ============================================================================

# --- Database (used by the db service AND composed into the API's URL) ------
POSTGRES_USER=praxis
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=praxis

# --- Web ---------------------------------------------------------------------
# Host port the app is served on (http://localhost:<WEB_PORT>).
WEB_PORT=8080

# --- API ---------------------------------------------------------------------
# Browser origin(s) allowed by CORS. The web app is same-origin (nginx proxies
# /api), so this only matters if the API is called from another origin.
PRAXIS_CORS_ORIGINS=http://localhost:8080

# --- LLM (optional — the operational brief works without it via the template) -
# Set ENABLED=true and provide a key to turn on AI-structured narration. The
# numeric guard still validates every figure; a key is never committed.
PRAXIS_LLM_ENABLED=false
PRAXIS_LLM_API_KEY=
PRAXIS_LLM_MODEL=claude-sonnet-5
