# ============================================================================
# Praxis — environment configuration
# ----------------------------------------------------------------------------
# Copy this file to `.env` and adjust as needed:  cp .env.example .env
# The real `.env` is git-ignored. Every variable below has a working local
# default baked into the app/compose files, so a fresh clone runs as-is.
# ============================================================================

# --- PostgreSQL / PostGIS (consumed by docker-compose.yml) ------------------
POSTGRES_USER=praxis
POSTGRES_PASSWORD=praxis
POSTGRES_DB=praxis
# Host port for the database. Defaults to 5433 to avoid clashing with a stock
# Postgres already running on the conventional 5432.
POSTGRES_PORT=5433

# --- Backend (FastAPI; variables are read with the PRAXIS_ prefix) ----------
# Async SQLAlchemy URL. Host/port/user/db must match the Postgres settings above.
PRAXIS_DATABASE_URL=postgresql+asyncpg://praxis:praxis@localhost:5433/praxis
# Deployment environment: development | staging | production
PRAXIS_ENVIRONMENT=development
# Comma-separated list of browser origins allowed by CORS.
PRAXIS_CORS_ORIGINS=http://localhost:5173

# --- LLM (Phase 6 — operational brief narration) ----------------------------
# STRICTLY OPTIONAL. With narration disabled or no key present, the /act brief
# is produced by the deterministic template (every number computed by Praxis and
# validated by the numeric guard). Set these to enable AI-structured narration;
# the numeric guard still validates every figure and repairs any drift from the
# template. NEVER commit a real key — this file holds placeholders only.
PRAXIS_LLM_ENABLED=false
# Your Anthropic API key (leave blank to keep narration off).
PRAXIS_LLM_API_KEY=
# Model id (Claude). Example: claude-sonnet-5
PRAXIS_LLM_MODEL=claude-sonnet-5
# Anthropic Messages API base URL (override for a compatible gateway).
PRAXIS_LLM_BASE_URL=https://api.anthropic.com
# Anthropic API version header.
PRAXIS_LLM_API_VERSION=2023-06-01
# Generation bounds.
PRAXIS_LLM_MAX_TOKENS=2000
PRAXIS_LLM_TIMEOUT_S=30

# --- Frontend (Vite; variables must be prefixed with VITE_ to be exposed) ---
# Base URL the browser client uses to reach the API.
VITE_API_BASE_URL=http://localhost:8000
